# Copy to .env. Everything is optional: the defaults below are what the demo uses.

# Public base URL of this server (Alexa+ reaches <PUBLIC_URL>/mcp). Use a tunnel URL for remote hosts.
PUBLIC_URL=http://localhost:8787
PORT=8787
# Interface to bind (use 0.0.0.0 only behind a proxy/firewall)
HOST=127.0.0.1
# Browser origins allowed to call /mcp and the OAuth endpoints (":*" = any port); PUBLIC_URL is always allowed
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Prefill the demo family on the sign-in page (default: true on localhost)
DEMO_MODE=true
# Express trust proxy setting (e.g. 1 behind CloudFront/a load balancer)
TRUST_PROXY=loopback
# Sign-in/token requests per IP per minute
AUTH_RATE_LIMIT=30
# Paid (live-mode) stories per family per rolling 24 h
MAX_STORIES_PER_DAY=5

# 'bedrock' = live Amazon Bedrock + Polly; 'mock' = replay the bundled seed story (no AWS account needed)
AI_MODE=bedrock
AWS_REGION=us-east-1
TEXT_MODEL_ID=us.anthropic.claude-sonnet-4-6
IMAGE_MODEL_ID=stability.sd3-5-large-v1:0
IMAGE_REGION=us-west-2
NARRATOR_VOICE=Danielle
NARRATOR_ENGINE=neural

# Amazon Bedrock Guardrail (create one with `npm run create-guardrail`)
GUARDRAIL_ID=
GUARDRAIL_VERSION=1

# Alexa+ account linking
ALEXA_CLIENT_SECRET=change-me-alexa-secret
ALEXA_STRICT_401=true
# false = unauthenticated requests act as the demo family (handy with MCP Inspector)
REQUIRE_AUTH=true

# Bedtime-suitability review model (Claude Haiku 4.5 on Bedrock)
REVIEW_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
